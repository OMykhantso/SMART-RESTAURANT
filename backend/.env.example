# PostgreSQL connection string
DATABASE_URL="postgresql://smart:smart@localhost:5432/smart_restaurant?schema=public"
# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# Access token lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
PORT=4000
# Comma-separated list of allowed origins or *
CORS_ORIGIN="*"
# Restaurant time zone used by the booking engine
RESTAURANT_TZ="Europe/Kyiv"
# Simulated payment gateway latency (ms)
PAYMENT_SANDBOX_LATENCY_MS=700
