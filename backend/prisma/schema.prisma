// SMART RESTAURANT — логічна модель бази даних (PostgreSQL)
// Усі грошові значення зберігаються у копійках (Int), як у платіжних системах,
// щоб уникнути похибок чисел з плаваючою комою.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Довідники станів ───────────────────────────────

enum Role {
  CLIENT // клієнт ресторану
  STAFF // працівник залу: хостес / офіціант
  KITCHEN // кухар — kitchen display
  ADMIN // технічна роль: користувачі, меню, столики, аналітика
  COURIER // курʼєр служби доставки (мобільний застосунок)
}

enum TableZone {
  HALL
  TERRACE
  VIP
  BAR
}

enum TableShape {
  ROUND
  SQUARE
  RECT
}

enum ReservationStatus {
  PENDING // створено клієнтом, очікує підтвердження
  CONFIRMED // підтверджено працівником
  CHECKED_IN // гість прибув (check-in по QR)
  COMPLETED // візит завершено
  CANCELLED // скасовано
  REJECTED // відхилено рестораном
  NO_SHOW // гість не прийшов
}

enum ReservationSource {
  APP
  WEB
  STAFF
  WALK_IN
}

enum OrderStatus {
  NEW // створено клієнтом (доставка карткою — очікує оплати)
  CONFIRMED // прийнято, передано на кухню
  PREPARING // готується
  READY // готово до подачі / чекає курʼєра
  SERVED // подано до столу (у залі)
  PAID // оплачено (у залі)
  DELIVERING // курʼєр забрав замовлення і везе клієнту
  DELIVERED // доставлено клієнту
  CANCELLED
}

/// Тип замовлення: у залі ресторану (Restaurant API) або доставка (Delivery API)
enum OrderType {
  DINE_IN
  DELIVERY
}

enum OrderItemStatus {
  QUEUED
  COOKING
  READY
}

enum PaymentMethod {
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION // 3-D Secure підтвердження
  SUCCEEDED
  FAILED
  REFUNDED // кошти повернуто (скасована оплачена доставка)
}

// ─────────────────────────────────── Таблиці ───────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  name         String   @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  role         Role     @default(CLIENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reservations        Reservation[]  @relation("ReservationClient")
  createdReservations Reservation[]  @relation("ReservationCreator")
  orders              Order[]        @relation("OrderClient")
  createdOrders       Order[]        @relation("OrderCreator")
  processedPayments   Payment[]      @relation("PaymentProcessor")
  reviews             Review[]
  refreshTokens       RefreshToken[]
  statusChanges       StatusChange[]
  addresses           Address[]
  courierDeliveries   Delivery[]     @relation("DeliveryCourier")

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(60)
  slug        String  @unique @db.VarChar(60)
  emoji       String? @db.VarChar(8)
  description String? @db.VarChar(255)
  sortOrder   Int     @default(0) @map("sort_order")
  dishes      Dish[]

  @@map("categories")
}

model Dish {
  id           Int      @id @default(autoincrement())
  categoryId   Int      @map("category_id")
  name         String   @db.VarChar(100)
  description  String   @db.VarChar(500)
  price        Int // копійки
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  weightGrams  Int?     @map("weight_grams")
  calories     Int?
  prepTimeMin  Int      @default(15) @map("prep_time_min")
  isAvailable  Boolean  @default(true) @map("is_available") // стоп-лист
  isArchived   Boolean  @default(false) @map("is_archived")
  isVegetarian Boolean  @default(false) @map("is_vegetarian")
  isSpicy      Boolean  @default(false) @map("is_spicy")
  isChefChoice Boolean  @default(false) @map("is_chef_choice")
  tags         String[] @default([])
  allergens    String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([isAvailable, isArchived])
  @@map("dishes")
}

model DiningTable {
  id          Int        @id @default(autoincrement())
  number      Int        @unique
  seats       Int
  zone        TableZone  @default(HALL)
  shape       TableShape @default(SQUARE)
  posX        Float      @default(50) @map("pos_x") // координати на плані залу, % від ширини
  posY        Float      @default(50) @map("pos_y") // % від висоти
  qrToken     String     @unique @map("qr_token") @db.VarChar(64)
  isActive    Boolean    @default(true) @map("is_active")
  description String?    @db.VarChar(255)

  reservations Reservation[]
  orders       Order[]

  @@map("tables")
}

model Reservation {
  id           Int               @id @default(autoincrement())
  code         String            @unique @db.VarChar(12)
  checkinToken String            @map("checkin_token") @db.VarChar(64)
  userId       Int?              @map("user_id")
  createdById  Int?              @map("created_by_id")
  tableId      Int               @map("table_id")
  guests       Int
  startAt      DateTime          @map("start_at") @db.Timestamptz(3)
  endAt        DateTime          @map("end_at") @db.Timestamptz(3)
  status       ReservationStatus @default(PENDING)
  source       ReservationSource @default(APP)
  guestName    String?           @map("guest_name") @db.VarChar(100)
  guestPhone   String?           @map("guest_phone") @db.VarChar(20)
  notes        String?           @db.VarChar(500)
  cancelReason String?           @map("cancel_reason") @db.VarChar(255)
  confirmedAt  DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  checkedInAt  DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  completedAt  DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt  DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?          @relation("ReservationClient", fields: [userId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("ReservationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  table         DiningTable    @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders        Order[]
  statusChanges StatusChange[]

  @@index([tableId, startAt])
  @@index([userId, startAt])
  @@index([status, startAt])
  @@map("reservations")
}

model Order {
  id               Int         @id @default(autoincrement())
  type             OrderType   @default(DINE_IN)
  reservationId    Int?        @map("reservation_id") // лише для DINE_IN
  tableId          Int?        @map("table_id") // лише для DINE_IN
  userId           Int?        @map("user_id")
  createdById      Int         @map("created_by_id")
  status           OrderStatus @default(NEW)
  subtotal         Int // копійки
  total            Int // копійки
  notes            String?     @db.VarChar(500)
  cancelReason     String?     @map("cancel_reason") @db.VarChar(255)
  estimatedReadyAt DateTime?   @map("estimated_ready_at") @db.Timestamptz(3)
  confirmedAt      DateTime?   @map("confirmed_at") @db.Timestamptz(3)
  preparingAt      DateTime?   @map("preparing_at") @db.Timestamptz(3)
  readyAt          DateTime?   @map("ready_at") @db.Timestamptz(3)
  servedAt         DateTime?   @map("served_at") @db.Timestamptz(3)
  paidAt           DateTime?   @map("paid_at") @db.Timestamptz(3)
  cancelledAt      DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  reservation   Reservation?   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  table         DiningTable?   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  user          User?          @relation("OrderClient", fields: [userId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payments      Payment[]
  reviews       Review[]
  statusChanges StatusChange[]
  delivery      Delivery?

  @@index([type, status, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([reservationId])
  @@map("orders")
}

model OrderItem {
  id        Int             @id @default(autoincrement())
  orderId   Int             @map("order_id")
  dishId    Int             @map("dish_id")
  quantity  Int
  unitPrice Int             @map("unit_price") // знімок ціни на момент замовлення, копійки
  notes     String?         @db.VarChar(255)
  status    OrderItemStatus @default(QUEUED)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish  Dish  @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([dishId])
  @@map("order_items")
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int           @map("order_id")
  amount         Int // сума замовлення, копійки
  tip            Int           @default(0) // чайові, копійки
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  provider       String        @default("sandbox") @db.VarChar(30)
  providerRef    String        @unique @map("provider_ref") @db.VarChar(64)
  cardBrand      String?       @map("card_brand") @db.VarChar(20)
  cardLast4      String?       @map("card_last4") @db.Char(4)
  failureCode    String?       @map("failure_code") @db.VarChar(40)
  failureMessage String?       @map("failure_message") @db.VarChar(255)
  idempotencyKey String?       @unique @map("idempotency_key") @db.VarChar(80)
  processedById  Int?          @map("processed_by_id")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(3)

  order       Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  processedBy User? @relation("PaymentProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status, paidAt])
  @@map("payments")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  orderId   Int      @map("order_id")
  dishId    Int?     @map("dish_id") // null — відгук про візит загалом
  rating    Int      @db.SmallInt
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish  Dish? @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([orderId, dishId])
  @@index([dishId])
  @@map("reviews")
}

// Журнал змін станів (аудит бізнес-процесу) — для бронювань та замовлень
model StatusChange {
  id            Int      @id @default(autoincrement())
  reservationId Int?     @map("reservation_id")
  orderId       Int?     @map("order_id")
  fromStatus    String?  @map("from_status") @db.VarChar(20)
  toStatus      String   @map("to_status") @db.VarChar(20)
  actorId       Int?     @map("actor_id")
  note          String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([orderId])
  @@map("status_changes")
}

// ─────────────────────────────── Доставка (Delivery API) ───────────────────────────────

/// Зона доставки: район міста з власною вартістю, мінімальною сумою і часом у дорозі
model DeliveryZone {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(60)
  description String? @db.VarChar(255)
  fee         Int // вартість доставки, копійки
  minOrder    Int     @map("min_order") // мінімальна сума замовлення, копійки
  freeFrom    Int?    @map("free_from") // безкоштовна доставка від суми, копійки
  travelMin   Int     @map("travel_min") // орієнтовний час у дорозі, хв
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  addresses  Address[]
  deliveries Delivery[]

  @@map("delivery_zones")
}

/// Збережені адреси клієнта
model Address {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  zoneId    Int      @map("zone_id")
  label     String   @db.VarChar(40) // «Дім», «Робота»
  street    String   @db.VarChar(120)
  house     String   @db.VarChar(20)
  apartment String?  @db.VarChar(20)
  entrance  String?  @db.VarChar(10)
  floor     String?  @db.VarChar(10)
  comment   String?  @db.VarChar(255)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("addresses")
}

/// Доставка замовлення (1 : 1 з orders.type = DELIVERY). Адреса зберігається знімком на момент замовлення.
model Delivery {
  orderId       Int           @id @map("order_id")
  zoneId        Int           @map("zone_id")
  courierId     Int?          @map("courier_id")
  recipientName String        @map("recipient_name") @db.VarChar(100)
  phone         String        @db.VarChar(20)
  street        String        @db.VarChar(120)
  house         String        @db.VarChar(20)
  apartment     String?       @db.VarChar(20)
  entrance      String?       @db.VarChar(10)
  floor         String?       @db.VarChar(10)
  comment       String?       @db.VarChar(255)
  fee           Int // вартість доставки, копійки
  paymentMethod PaymentMethod @map("payment_method") // CARD — онлайн одразу, CASH — курʼєру
  changeFrom    Int?          @map("change_from") // готівка: решта з суми, копійки
  etaAt         DateTime?     @map("eta_at") @db.Timestamptz(3) // прогноз часу доставки
  assignedAt    DateTime?     @map("assigned_at") @db.Timestamptz(3)
  pickedUpAt    DateTime?     @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt   DateTime?     @map("delivered_at") @db.Timestamptz(3)

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  zone    DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  courier User?        @relation("DeliveryCourier", fields: [courierId], references: [id], onDelete: SetNull)

  @@index([courierId])
  @@index([zoneId])
  @@map("deliveries")
}
